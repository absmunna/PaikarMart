{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx apps/backend/server.ts",
    "start": "node server.js",
    "build": "vite build --config apps/frontend/vite.config.ts && esbuild apps/backend/server.ts --bundle --platform=node --packages=external --format=esm --outfile=server.js",
    "build:frontend": "vite build --config apps/frontend/vite.config.ts",
    "build:server": "esbuild apps/backend/server.ts --bundle --platform=node --packages=external --format=esm --outfile=server.js",
    "preview": "vite preview --config apps/frontend/vite.config.ts",
    "clean": "rm -rf apps/frontend/dist apps/backend/server.js server.js",
    "lint": "tsc --noEmit --project apps/frontend/tsconfig.json",
    "test:security": "tsx --test apps/backend/tests/*.security.test.ts",
    "test:frontend": "tsx --test apps/frontend/tests/*.test.ts apps/frontend/src/portals/utilities/user-profile/components/*.test.ts",
    "test": "tsx --test apps/backend/tests/*.security.test.ts apps/frontend/tests/*.test.ts apps/frontend/src/portals/utilities/user-profile/components/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^3.1.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/react-router-dom": "^5.3.3",
    "@vis.gl/react-google-maps": "^1.10.2",
    "@vitejs/plugin-react": "^6.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.5",
    "firebase": "^13.3.0",
    "firebase-admin": "^14.5.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "vite": "^8.3.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.16.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
