# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# Multi-Cloud Free Tier Deployment Configurations (Zero Billing Card Needed)
# 1. Frontend: Vercel Hobby (Vite React SPA)
# 2. Auth & Firestore: Firebase Spark Free Plan (Project: gen-lang-client-0609196204)
# 3. Backend: Render Free Web Service (/api/*)
# 4. SQL Database & File Storage: Supabase Free Tier (PostgreSQL + 1GB Storage)
# ==============================================================================

# PostgreSQL / Prisma Transaction Pooler (Server-Only Secret — port 6543, optional)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL & Free Storage (Avatars + Private KYC Docs)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="server-only-service-role-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Optional on Vercel: Leave empty to proxy /api/* via vercel.json rewrite, or set Render URL
VITE_API_BASE_URL=""

# Firebase Backend Verification (Spark Free Plan — no Service Account JSON needed for ID token verify)
FIREBASE_PROJECT_ID="gen-lang-client-0609196204"
CORS_ORIGINS="http://localhost:3000,https://your-app.vercel.app"
PAYMENT_WEBHOOK_SECRET="server-only-hmac-payment-webhook-secret"
COURIER_WEBHOOK_SECRET="server-only-hmac-courier-webhook-secret"

# Firebase Frontend Config (Optional on Vercel: overrides firebase-applet-config.json when set)
# Keep unset in AI Studio so preview automatically uses firebase-applet-config.json
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="gen-lang-client-0609196204.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0609196204"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
# Keep "false" on Spark Free Plan (uploads route through Supabase Free Storage instead)
VITE_ENABLE_FIREBASE_STORAGE="false"

# Bangladesh Payment Gateways (Optional — Server-Side Only)
# Set PAYMENT_SANDBOX_MODE="true" for test checkout without live merchant credentials
PAYMENT_SANDBOX_MODE="true"
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
NAGAD_BASE_URL="https://sandbox.mynagad.com:10060/remote-payment-gateway-1.0/api/dfs"
NAGAD_MERCHANT_ID=""
NAGAD_PUBLIC_KEY=""
NAGAD_PRIVATE_KEY=""
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_IS_LIVE="false"

